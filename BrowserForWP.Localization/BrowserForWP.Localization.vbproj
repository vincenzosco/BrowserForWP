<?xml version="1.0" encoding="utf-8"?>
<!--
  BrowserForWP.Localization — Windows Phone 8.1 class library.

  Uses Windows.Globalization and Windows.ApplicationModel.Resources, which the
  Windows Phone SDK provides implicitly. If Visual Studio reports missing targets
  on your installation, delete this file, add a "Class Library (Windows Phone
  8.1)" project named BrowserForWP.Localization in this folder, and include the
  .vb files. See docs/MAINTAINING.md.
-->
<Project ToolsVersion="12.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{C0DE0003-0003-4A2B-9C3D-1B2C3D4E5F03}</ProjectGuid>
    <OutputType>Library</OutputType>
    <!-- See BrowserForWP.Crypto.vbproj: RootNamespace is prepended to the file's
         own Namespace block, and the sources declare `Namespace Localization`.
         This must be `BrowserForWP` for the types to land at
         BrowserForWP.Localization.*, which is what MainPage.xaml.vb imports. -->
    <RootNamespace>BrowserForWP</RootNamespace>
    <AssemblyName>BrowserForWP.Localization</AssemblyName>
    <DefaultLanguage>en-US</DefaultLanguage>
    <TargetPlatformVersion>8.1</TargetPlatformVersion>
    <!-- See BrowserForWP.Crypto.vbproj for why this line is kept even though the
         conditional PropertyGroup at the foot of this file sets the same value,
         and for why it is not what makes the project resolvable as a reference. -->
    <TargetPlatformIdentifier>WindowsPhoneApp</TargetPlatformIdentifier>
    <MinimumVisualStudioVersion>12</MinimumVisualStudioVersion>
    <FileAlignment>512</FileAlignment>
    <!-- See the same note in BrowserForWP.Crypto.vbproj: this must be the Windows
         Phone 8.1 flavour, not the Windows Store one, or the IDE cannot resolve
         this project as a reference from the app. -->
    <ProjectTypeGuids>{76F1466A-8B6D-4E39-A767-685A06062A39};{F184B08F-C81C-45F6-A57F-5ABD9991F28F}</ProjectTypeGuids>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <DefineDebug>true</DefineDebug>
    <DefineTrace>true</DefineTrace>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG,TRACE,NETFX_CORE</DefineConstants>
    <DocumentationFile>BrowserForWP.Localization.xml</DocumentationFile>
    <NoWarn>41999,42016,42017,42018,42019,42020,42021,42022,42032,42036,42314</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <DefineDebug>false</DefineDebug>
    <DefineTrace>true</DefineTrace>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE,NETFX_CORE</DefineConstants>
    <DocumentationFile>BrowserForWP.Localization.xml</DocumentationFile>
    <NoWarn>41999,42016,42017,42018,42019,42020,42021,42022,42032,42036,42314</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|ARM' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <DefineDebug>true</DefineDebug>
    <DefineTrace>true</DefineTrace>
    <OutputPath>bin\ARM\Debug\</OutputPath>
    <DefineConstants>DEBUG,TRACE,NETFX_CORE</DefineConstants>
    <DocumentationFile>BrowserForWP.Localization.xml</DocumentationFile>
    <PlatformTarget>ARM</PlatformTarget>
    <UseVSHostingProcess>false</UseVSHostingProcess>
    <NoWarn>41999,42016,42017,42018,42019,42020,42021,42022,42032,42036,42314</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|ARM' ">
    <DebugType>pdbonly</DebugType>
    <DefineTrace>true</DefineTrace>
    <Optimize>true</Optimize>
    <OutputPath>bin\ARM\Release\</OutputPath>
    <DefineConstants>TRACE,NETFX_CORE</DefineConstants>
    <DocumentationFile>BrowserForWP.Localization.xml</DocumentationFile>
    <PlatformTarget>ARM</PlatformTarget>
    <UseVSHostingProcess>false</UseVSHostingProcess>
    <NoWarn>41999,42016,42017,42018,42019,42020,42021,42022,42032,42036,42314</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|x86' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <DefineDebug>true</DefineDebug>
    <DefineTrace>true</DefineTrace>
    <OutputPath>bin\x86\Debug\</OutputPath>
    <DefineConstants>DEBUG,TRACE,NETFX_CORE</DefineConstants>
    <DocumentationFile>BrowserForWP.Localization.xml</DocumentationFile>
    <PlatformTarget>x86</PlatformTarget>
    <UseVSHostingProcess>false</UseVSHostingProcess>
    <NoWarn>41999,42016,42017,42018,42019,42020,42021,42022,42032,42036,42314</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|x86' ">
    <DebugType>pdbonly</DebugType>
    <DefineTrace>true</DefineTrace>
    <Optimize>true</Optimize>
    <OutputPath>bin\x86\Release\</OutputPath>
    <DefineConstants>TRACE,NETFX_CORE</DefineConstants>
    <DocumentationFile>BrowserForWP.Localization.xml</DocumentationFile>
    <PlatformTarget>x86</PlatformTarget>
    <UseVSHostingProcess>false</UseVSHostingProcess>
    <NoWarn>41999,42016,42017,42018,42019,42020,42021,42022,42032,42036,42314</NoWarn>
  </PropertyGroup>
  <!--
    BC40000 is the obsolete-usage warning, and there is exactly one and only one
    deliberate use of a deprecated API in this project: `New ResourceLoader(name)`
    in Localizer.vb, kept because the replacement is tied to the view's cached
    ResourceContext and would break the runtime language switch. VB 12 has no
    `#Disable Warning` directive (that is VB 14+), so this is the only supported
    place to silence it. Appended here rather than edited into each of the six
    per-configuration NoWarn lists above. See Localizer.vb and
    docs/MAINTAINING.md Round 24.
  -->
  <PropertyGroup>
    <NoWarn>$(NoWarn),40000</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="LanguageCatalog.vb" />
    <Compile Include="Localizer.vb" />
  </ItemGroup>
  <ItemGroup>
    <Import Include="Microsoft.VisualBasic" />
    <Import Include="System" />
    <Import Include="System.Collections.Generic" />
    <Import Include="System.Diagnostics" />
    <Import Include="System.Globalization" />
    <Import Include="Windows.ApplicationModel.Resources" />
    <Import Include="Windows.ApplicationModel.Resources.Core" />
    <Import Include="Windows.Globalization" />
  </ItemGroup>
  <PropertyGroup Condition=" '$(VisualStudioVersion)' == '' or '$(VisualStudioVersion)' &lt; '12.0' ">
    <VisualStudioVersion>12.0</VisualStudioVersion>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(TargetPlatformIdentifier)' == '' ">
    <TargetPlatformIdentifier>WindowsPhoneApp</TargetPlatformIdentifier>
  </PropertyGroup>
  <PropertyGroup>
    <OptionExplicit>On</OptionExplicit>
  </PropertyGroup>
  <PropertyGroup>
    <OptionCompare>Binary</OptionCompare>
  </PropertyGroup>
  <PropertyGroup>
    <OptionStrict>On</OptionStrict>
  </PropertyGroup>
  <PropertyGroup>
    <OptionInfer>On</OptionInfer>
  </PropertyGroup>
  <Import Project="$(MSBuildExtensionsPath)\Microsoft\WindowsXaml\v$(VisualStudioVersion)\Microsoft.Windows.UI.Xaml.VisualBasic.targets" Condition="Exists('$(MSBuildExtensionsPath)\Microsoft\WindowsXaml\v$(VisualStudioVersion)\Microsoft.Windows.UI.Xaml.VisualBasic.targets')" />
</Project>

  <!-- The page this phone serves so a token can be pasted from a computer -->
  <data name="TokenInboxTitle" xml:space="preserve">
    <value>Paste the token from another device</value>
  </data>
  <data name="TokenInboxNote" xml:space="preserve">
    <value>This opens a page on this phone, reachable from a computer on the same Wi-Fi, for a minute: as long as this screen stays open. Open the address below in the computer's browser, paste the token there, and type the code you can read here. The token travels in the clear inside the local network: that is your own network rather than the Internet, and this phone has no certificate for a name nothing resolves. After it is saved there is nothing else to do: the address and the token go into the server you chose and the engine switches to Server. Nothing can be deleted from that page: to have a token removed, open an issue on the project's page.</value>
  </data>

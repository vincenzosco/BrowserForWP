<Page
    x:Class="BrowserForWP.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BrowserForWP"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <!-- Single root: layout grid plus both overlays as siblings inside one Grid. -->
    <Grid>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="8,8,8,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!--
                  TextBoxBackgroundThemeBrush is the key Windows Phone 8.1 defines
                  for a text field, and the one its own TextBox style uses. The
                  previous name here, TextControlBackground, is a UWP/Win10 key
                  that this platform does not define. A ThemeResource is resolved
                  when the page LOADS, not when it compiles, so the build accepted
                  it: the page would have thrown on the handset instead. Every
                  ThemeResource key is checked now by tools/check-vb.mjs.
                -->
                <Border Grid.Column="0"
                        Background="{ThemeResource TextBoxBackgroundThemeBrush}"
                        CornerRadius="4" Padding="4,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="SecurityGlyph" FontSize="14"
                                   VerticalAlignment="Center" Margin="4,0"
                                   Text="&#x26A0;"/>
                        <TextBox x:Name="AddressBox" BorderThickness="0" Width="260"
                                 VerticalAlignment="Center"
                                 InputScope="Url"
                                 AcceptsReturn="False"
                                 KeyDown="AddressBox_KeyDown"
                                 GotFocus="AddressBox_GotFocus"
                                 LostFocus="AddressBox_LostFocus"/>
                    </StackPanel>
                </Border>

                <Button Grid.Column="1" x:Name="GoButton"
                        Click="GoButton_Click" Margin="6,0,0,0"/>
            </Grid>

            <ProgressBar Grid.Row="1" x:Name="LoadProgress" Height="3"
                         IsIndeterminate="False" Minimum="0" Maximum="100" Value="0"/>

            <Grid Grid.Row="2">
                <Border x:Name="ContentHost"/>
                <!--
                  The keys a soft keyboard cannot send. On a phone the system
                  keyboard is a separate process with its own key set: it has
                  letters, Enter and Backspace, and no Tab, no Escape and no arrow
                  keys at all. A form with two fields is therefore unusable on this
                  engine without this bar, which is why it is part of the input
                  path and not a nicety.

                  Shift+Tab is deliberately NOT here: the protocol carries a
                  modifier byte, the server's key handler ignores it, and a button
                  that presses Tab while claiming Shift would be a lie in the UI.
                -->
                <Border x:Name="RemoteKeysBar" Visibility="Collapsed"
                        VerticalAlignment="Bottom" Margin="8"
                        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                        CornerRadius="4" Padding="6">
                    <!-- Scrollable for the same reason the toolbar is: nine buttons
                         and a label each do not fit a 480-pixel screen, and a bar
                         whose last button cannot be reached is a bar with eight. -->
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="KeyTabButton" Click="KeyTabButton_Click" Margin="0,0,4,0"/>
                        <Button x:Name="KeyEnterButton" Click="KeyEnterButton_Click" Margin="0,0,4,0"/>
                        <Button x:Name="KeyEscapeButton" Click="KeyEscapeButton_Click" Margin="0,0,4,0"/>
                        <Button x:Name="KeyBackspaceButton" Click="KeyBackspaceButton_Click" Margin="0,0,4,0"/>
                        <Button x:Name="KeyLeftButton" Click="KeyLeftButton_Click" Margin="0,0,4,0"/>
                        <Button x:Name="KeyUpButton" Click="KeyUpButton_Click" Margin="0,0,4,0"/>
                        <Button x:Name="KeyDownButton" Click="KeyDownButton_Click" Margin="0,0,4,0"/>
                        <Button x:Name="KeyRightButton" Click="KeyRightButton_Click" Margin="0,0,4,0"/>
                        <Button x:Name="KeyBarCloseButton" Click="KeyBarCloseButton_Click"/>
                    </StackPanel>
                    </ScrollViewer>
                </Border>

                <Border x:Name="FindBar" Visibility="Collapsed"
                        VerticalAlignment="Top" Margin="8"
                        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                        CornerRadius="4" Padding="8">
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="FindBox" Width="160" InputScope="Search"
                                 KeyDown="FindBox_KeyDown"/>
                        <Button x:Name="FindNextButton" Margin="6,0,0,0"
                                Click="FindNextButton_Click"/>
                        <Button x:Name="FindCloseButton" Margin="6,0,0,0"
                                Click="FindCloseButton_Click"/>
                        <TextBlock x:Name="FindResult" VerticalAlignment="Center"
                                   Margin="6,0,0,0" Opacity="0.8"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="3" Margin="8,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" x:Name="ErrorText" TextWrapping="Wrap"
                           Opacity="0.9" Visibility="Collapsed"/>

                <!-- Shares the error row, right-aligned: the Loading/Done status
                     goes here so the two localized strings in the catalogue have a
                     real consumer. The retry button appears beside it, only while
                     an error is shown. -->
                <TextBlock Grid.Column="1" x:Name="StatusText" TextWrapping="NoWrap"
                           Margin="8,0,0,0" Opacity="0.6" VerticalAlignment="Top"/>
                <Button Grid.Column="2" x:Name="RetryButton" Click="RetryButton_Click"
                        Visibility="Collapsed" Margin="6,0,0,0"/>
            </Grid>

            <ScrollViewer Grid.Row="4" Margin="8"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BackButton" Click="BackButton_Click" Margin="0,0,6,0"/>
                    <Button x:Name="ForwardButton" Click="ForwardButton_Click" Margin="0,0,6,0"/>
                    <Button x:Name="ReloadButton" Click="ReloadButton_Click" Margin="0,0,6,0"/>
                    <Button x:Name="StopButton" Click="StopButton_Click" Margin="0,0,6,0"/>
                    <Button x:Name="TabsButton" Click="TabsButton_Click" Margin="0,0,6,0"/>
                    <Button x:Name="FindButton" Click="FindButton_Click" Margin="0,0,6,0"/>
                    <Button x:Name="ReadingButton" Click="ReadingButton_Click" Margin="0,0,6,0"/>
                    <Button x:Name="RemoteKeysButton" Click="RemoteKeysButton_Click" Margin="0,0,6,0"/>
                    <Button x:Name="ShareButton" Click="ShareButton_Click" Margin="0,0,6,0"/>
                    <Button x:Name="SavePageButton" Click="SavePageButton_Click" Margin="0,0,6,0"/>
                    <Button x:Name="SecurityDetailsButton" Click="SecurityDetailsButton_Click" Margin="0,0,6,0"/>
                    <Button x:Name="SettingsButton" Click="SettingsButton_Click"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid x:Name="SettingsOverlay" Visibility="Collapsed"
              Background="#CC000000">
            <Border Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                    Padding="16" Margin="24" CornerRadius="8"
                    VerticalAlignment="Center">
                <ScrollViewer MaxHeight="520">
                <StackPanel>
                    <TextBlock x:Name="SettingsTitle" FontSize="24" Margin="0,0,0,12"/>

                    <TextBlock x:Name="LanguageLabel" Margin="0,0,0,4"/>
                    <ComboBox x:Name="LanguagePicker" Width="280"
                              SelectionChanged="LanguagePicker_SelectionChanged"/>

                    <CheckBox x:Name="DesktopToggle" Margin="0,8,0,0"
                              Checked="DesktopToggle_Checked"
                              Unchecked="DesktopToggle_Unchecked"/>
                    <CheckBox x:Name="PrivateModeToggle" Margin="0,4,0,0"
                              Checked="PrivateModeToggle_Checked"
                              Unchecked="PrivateModeToggle_Unchecked"/>
                    <CheckBox x:Name="NightModeToggle" Margin="0,4,0,0"
                              Checked="NightModeToggle_Checked"
                              Unchecked="NightModeToggle_Unchecked"/>
                    <CheckBox x:Name="BlockTrackersToggle" Margin="0,4,0,0"
                              Checked="BlockTrackersToggle_Checked"
                              Unchecked="BlockTrackersToggle_Unchecked"/>
                    <CheckBox x:Name="RestoreSessionToggle" Margin="0,4,0,0"
                              Checked="RestoreSessionToggle_Checked"
                              Unchecked="RestoreSessionToggle_Unchecked"/>
                    <CheckBox x:Name="LiteRedirectsToggle" Margin="0,4,0,0"
                              Checked="LiteRedirectsToggle_Checked"
                              Unchecked="LiteRedirectsToggle_Unchecked"/>

                    <TextBlock x:Name="HomepageLabel" Margin="0,8,0,4"/>
                    <TextBox x:Name="HomepageBox" Width="280" InputScope="Url"
                             LostFocus="HomepageBox_LostFocus"/>

                    <!-- Per-site display: applies to the current host only. -->
                    <TextBlock x:Name="SiteHostText" Margin="0,8,0,4" Opacity="0.8"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="TextSizeLabel" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="TextSmallerButton" Content="−"
                                Click="TextSmallerButton_Click" Margin="0,0,6,0"/>
                        <Button x:Name="TextLargerButton" Content="+"
                                Click="TextLargerButton_Click"/>
                    </StackPanel>
                    <CheckBox x:Name="ImagesToggle" Margin="0,4,0,0"
                              Checked="ImagesToggle_Checked"
                              Unchecked="ImagesToggle_Unchecked"/>

                    <TextBlock x:Name="EngineLabel" Margin="0,8,0,4"/>
                    <ComboBox x:Name="EnginePicker" Width="280"
                              SelectionChanged="EnginePicker_SelectionChanged"/>
                    <TextBlock x:Name="EngineStatusText" TextWrapping="Wrap"
                               FontSize="12" Opacity="0.8" Margin="0,4,0,0"/>

                    <!--
                      The remote engine's server, and the disclosure that belongs
                      with it. These fields exist because the engine reads them: the
                      plan for this round specified no settings surface at all, and
                      then asked a person to paste a token into one.

                      No PasswordBox for the tokens. A device token is not typed
                      from memory and not read over a shoulder; it is pasted once
                      from the server's own output, and a masked field that cannot be
                      checked for a stray character is the worse tool for that.
                    -->
                    <TextBlock x:Name="RemoteNoticeLabel" TextWrapping="Wrap"
                               FontSize="12" Opacity="0.8" Margin="0,10,0,0"/>
                    <TextBlock x:Name="RemoteServerLabel" Margin="0,8,0,4"/>
                    <TextBox x:Name="RemoteServerBox" Width="280" InputScope="Url"
                             LostFocus="RemoteServerBox_LostFocus"/>
                    <TextBlock x:Name="RemoteTokenLabel" Margin="0,8,0,4"/>
                    <TextBox x:Name="RemoteTokenBox" Width="280"
                             LostFocus="RemoteTokenBox_LostFocus"/>
                    <TextBlock x:Name="RemoteBackupLabel" Margin="0,8,0,4"/>
                    <TextBox x:Name="RemoteBackupBox" Width="280" InputScope="Url"
                             LostFocus="RemoteBackupBox_LostFocus"/>
                    <TextBlock x:Name="RemoteBackupTokenLabel" Margin="0,8,0,4"/>
                    <TextBox x:Name="RemoteBackupTokenBox" Width="280"
                             LostFocus="RemoteBackupTokenBox_LostFocus"/>
                    <CheckBox x:Name="RemoteEnabledToggle" Margin="0,4,0,0"
                              Checked="RemoteEnabledToggle_Checked"
                              Unchecked="RemoteEnabledToggle_Unchecked"/>

                    <TextBlock x:Name="TabsTitle" FontSize="18" Margin="0,16,0,4"/>
                    <ListBox x:Name="TabsList" Height="80" Width="280"
                             SelectionChanged="TabsList_SelectionChanged"/>
                    <Button x:Name="CloseTabButton" Margin="0,4,0,0"
                            Click="CloseTabButton_Click"/>

                    <TextBlock x:Name="HistoryTitle" FontSize="18" Margin="0,12,0,4"/>
                    <ListBox x:Name="HistoryList" Height="80" Width="280"
                             SelectionChanged="HistoryList_SelectionChanged"/>
                    <Button x:Name="ClearHistoryButton" Margin="0,4,0,0"
                            Click="ClearHistoryButton_Click"/>

                    <TextBlock x:Name="FavoritesTitle" FontSize="18" Margin="0,12,0,4"/>
                    <ListBox x:Name="FavoritesList" Height="80" Width="280"
                             SelectionChanged="FavoritesList_SelectionChanged"/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="AddFavoriteButton" Margin="0,4,6,0"
                                Click="AddFavoriteButton_Click"/>
                        <Button x:Name="RemoveFavoriteButton" Margin="0,4,0,0"
                                Click="RemoveFavoriteButton_Click"/>
                    </StackPanel>

                    <TextBlock x:Name="SavedPagesTitle" FontSize="18" Margin="0,12,0,4"/>
                    <ListBox x:Name="SavedPagesList" Height="80" Width="280"
                             SelectionChanged="SavedPagesList_SelectionChanged"/>
                    <Button x:Name="DeleteSavedButton" Margin="0,4,0,0"
                            Click="DeleteSavedButton_Click"/>

                    <TextBlock x:Name="SpeedDialTitle" FontSize="18" Margin="0,12,0,4"/>
                    <ListBox x:Name="SpeedDialList" Height="80" Width="280"
                             SelectionChanged="SpeedDialList_SelectionChanged"/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="SpeedDialAddButton" Margin="0,4,6,0"
                                Click="SpeedDialAddButton_Click"/>
                        <Button x:Name="SpeedDialRemoveButton" Margin="0,4,0,0"
                                Click="SpeedDialRemoveButton_Click"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="BackupButton" Margin="0,0,6,0"
                                Click="BackupButton_Click"/>
                        <Button x:Name="RestoreButton" Margin="0,0,0,0"
                                Click="RestoreButton_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="BackupStatus" TextWrapping="Wrap"
                               Opacity="0.8" Margin="0,4,0,0"/>

                    <Button x:Name="DiagnosticsButton" Margin="0,12,0,6"
                            Click="DiagnosticsButton_Click"/>
                    <Button x:Name="CloseSettingsButton" Click="CloseSettingsButton_Click"/>
                </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid x:Name="DiagnosticsOverlay" Visibility="Collapsed"
              Background="#CC000000">
            <Border Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                    Padding="16" Margin="24" CornerRadius="8"
                    VerticalAlignment="Center">
                <ScrollViewer MaxHeight="520">
                <StackPanel>
                    <TextBlock x:Name="DiagnosticsTitle" FontSize="18" Margin="0,0,0,4"/>
                    <TextBlock x:Name="EngineText" TextWrapping="Wrap" Margin="0,0,0,8"
                               Opacity="0.8"/>

                    <Button x:Name="CompatProbeButton" Margin="0,0,0,6"
                            Click="CompatProbeButton_Click"/>
                    <TextBlock x:Name="CompatProbeResult" TextWrapping="Wrap"
                               Opacity="0.8" Margin="0,0,0,8"/>

                    <TextBlock x:Name="TlsProbeHostLabel" Margin="0,0,0,4"/>
                    <TextBox x:Name="TlsHostBox" Width="280" InputScope="Url"/>
                    <Button x:Name="TlsProbeButton" Margin="0,4,0,6"
                            Click="TlsProbeButton_Click"/>
                    <TextBlock x:Name="TlsProbeResult" TextWrapping="Wrap"
                               Opacity="0.8" Margin="0,0,0,8"/>

                    <TextBlock x:Name="DohServerLabel" Margin="0,0,0,4"/>
                    <TextBox x:Name="DohServerBox" Width="280" InputScope="Url"
                             LostFocus="DohServerBox_LostFocus"/>

                    <TextBlock x:Name="PinTitle" FontSize="18" Margin="0,12,0,4"/>
                    <TextBox x:Name="PinHostBox" Width="280" InputScope="Url"/>
                    <TextBox x:Name="PinValueBox" Width="280" Margin="0,4,0,0"/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="PinAddButton" Margin="0,4,6,0"
                                Click="PinAddButton_Click"/>
                        <Button x:Name="PinRemoveButton" Margin="0,4,0,0"
                                Click="PinRemoveButton_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="PinStatus" TextWrapping="Wrap"
                               Opacity="0.8" Margin="0,4,0,8"/>

                    <!-- The IE-mode check stays: it is the instrument behind the
                         documented "IE-adaptation is closed" claim. The parse-page
                         demo that lived here is gone; rendering over the app's own
                         transport is what the engine picker in Settings is for. -->
                    <Button x:Name="IeModeButton" Margin="0,0,0,6"
                            Click="IeModeButton_Click"/>
                    <TextBlock x:Name="IeModeResult" TextWrapping="Wrap"
                               FontFamily="Consolas" FontSize="12"
                               MaxHeight="160" Margin="0,0,0,8" Opacity="0.85"/>

                    <Button x:Name="DiagnosticsBackButton" Margin="0,6,0,0"
                            Click="DiagnosticsBackButton_Click"/>
                </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid x:Name="OfflineOverlay" Visibility="Collapsed"
              Background="#CC000000">
            <Border Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                    Padding="16" Margin="24" CornerRadius="8"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="OfflineTitle" FontSize="18" Margin="0,0,0,8"
                               TextWrapping="Wrap"/>
                    <ScrollViewer MaxHeight="420">
                        <TextBlock x:Name="OfflineBody" TextWrapping="Wrap"
                                   FontSize="16" LineHeight="24"/>
                    </ScrollViewer>
                    <Button x:Name="OfflineBackButton" Margin="0,8,0,0"
                            Click="OfflineBackButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</Page>

  <ItemGroup>
    <AppxManifest Include="Package.appxmanifest">
      <SubType>Designer</SubType>
    </AppxManifest>
  </ItemGroup>
  <ItemGroup>
    <!--
      Both scale-100 and scale-240 assets, every one of them explicitly
      qualified. The manifest names the LOGICAL path (Assets\Logo.png) and the
      platform resolves it to the right variant at runtime; the files on disk
      must not mix qualified and unqualified names, or the packaging build warns
      with APPX1621 and the choice becomes unpredictable on 100-scale devices.
      Regenerate every one of these with: python3 tools/make_logo.py
    -->
    <Content Include="Assets\Logo.scale-100.png" />
    <Content Include="Assets\Logo.scale-240.png" />
    <Content Include="Assets\SmallLogo.scale-100.png" />
    <Content Include="Assets\SmallLogo.scale-240.png" />
    <Content Include="Assets\SplashScreen.scale-100.png" />
    <Content Include="Assets\SplashScreen.scale-240.png" />
    <Content Include="Assets\Square71x71Logo.scale-100.png" />
    <Content Include="Assets\Square71x71Logo.scale-240.png" />
    <Content Include="Assets\StoreLogo.scale-100.png" />
    <Content Include="Assets\StoreLogo.scale-240.png" />
    <Content Include="Assets\WideLogo.scale-100.png" />
    <Content Include="Assets\WideLogo.scale-240.png" />
    <!--
      The polyfill has ONE canonical source, in BrowserForWP.Polyfill. It is
      included here with a Link so it ships inside the app package at
      Polyfill\compat.js without being duplicated in the repository.

      This previously read <Content Include="Polyfill\compat.js" />, pointing at
      a path that does not exist in this project. A declared content item whose
      file is absent fails the build with an unattributed "cannot find the path
      specified", and because it fails early the XAML compile never runs, so
      App.g.vb is never generated and the project loses both InitializeComponent
      and its generated entry point. One missing file, a cascade of errors that
      all look like code problems.
    -->
    <Content Include="..\BrowserForWP.Polyfill\compat.js">
      <Link>Polyfill\compat.js</Link>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <!-- UI strings. The hosting platform resolves the language; see
         BrowserForWP.Localization/Localizer.vb for the resolution order. -->
    <PRIResource Include="Strings\en-US\Resources.resw" />
    <PRIResource Include="Strings\it-IT\Resources.resw" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\BrowserForWP.Core\BrowserForWP.Core.vbproj">
      <Project>{C0DE0002-0002-4A2B-9C3D-1B2C3D4E5F02}</Project>
      <Name>BrowserForWP.Core</Name>
    </ProjectReference>
    <ProjectReference Include="..\BrowserForWP.Crypto\BrowserForWP.Crypto.vbproj">
      <Project>{C0DE0001-0001-4A2B-9C3D-1B2C3D4E5F01}</Project>
      <Name>BrowserForWP.Crypto</Name>
    </ProjectReference>
    <ProjectReference Include="..\BrowserForWP.Localization\BrowserForWP.Localization.vbproj">
      <Project>{C0DE0003-0003-4A2B-9C3D-1B2C3D4E5F03}</Project>
      <Name>BrowserForWP.Localization</Name>
    </ProjectReference>
    <!--
      BrowserForWP.Net (TLS 1.3, DoH, HTTP/1.1) is the app's own network stack.
      It is referenced so it is compiled and packaged with the app; without a
      reference from somewhere, nothing in the solution builds it.

      Note that referencing it is NOT the same as UI automation routing through
      it: the WebView's own traffic still goes through Schannel at TLS 1.2. The
      TLS 1.3 channel is what BrowserForWP.Net's own HTTP client uses. Closing
      that gap is Task 10 in docs/superpowers/plans/2026-09-28-browserforwp.md.
    -->
    <ProjectReference Include="..\BrowserForWP.Net\BrowserForWP.Net.vbproj">
      <Project>{3B9E1C74-5A21-4F0E-9D8C-6E2A7B4F1D93}</Project>
      <Name>BrowserForWP.Net</Name>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>

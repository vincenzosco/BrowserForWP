<?xml version="1.0" encoding="utf-8"?>
<!--
  BrowserForWP.Crypto — Windows Phone 8.1 class library.

  Modelled on the application project's own .vbproj, which is the authoritative
  template for this SDK. If Visual Studio reports missing targets on your
  installation, delete this file, add a "Class Library (Windows Phone 8.1)"
  project named BrowserForWP.Crypto in the same folder, and include the .vb files
  — VS writes the correct project file for your exact SDK. See
  docs/MAINTAINING.md.
-->
<Project ToolsVersion="12.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{C0DE0001-0001-4A2B-9C3D-1B2C3D4E5F01}</ProjectGuid>
    <OutputType>Library</OutputType>
    <!-- RootNamespace is the PREFIX that is prepended to every file's own
         Namespace block. The sources declare `Namespace Crypto`, so this must be
         `BrowserForWP` for the types to land at BrowserForWP.Crypto.*. Setting it
         to `BrowserForWP.Crypto` here would put them at
         BrowserForWP.Crypto.Crypto.* and break every `Imports BrowserForWP.Crypto`. -->
    <RootNamespace>BrowserForWP</RootNamespace>
    <AssemblyName>BrowserForWP.Crypto</AssemblyName>
    <DefaultLanguage>en-US</DefaultLanguage>
    <TargetPlatformVersion>8.1</TargetPlatformVersion>
    <!-- Kept as a statement of intent. The conditional PropertyGroup at the foot
         of this file sets the same value when nothing else has, so this line
         changes no build. It is NOT what makes this project resolvable as a
         reference, and an earlier revision of this comment said it was: the
         component that decides that is the project system in the IDE, and it
         reads the flavour property below, not this one.

         THE PROPERTY BELOW IS DELIBERATELY NOT NAMED HERE. Naming it in a
         comment breaks the project, and not in a way any build can see: the
         IDE's Windows Phone project factory locates that property by scanning
         this file as TEXT, not by parsing it as XML, so the first occurrence of
         the name is the one that counts. An occurrence inside a comment, ahead
         of the real element, makes the flavour come back empty, and the IDE
         answers by refusing the whole project with
         "The application for the project is not installed." It carries no
         diagnostic code, it comes from a component MSBuild never runs, and
         every configuration here stays green. Measured on the guest: this file
         with only those two words taken out of this comment loads and builds,
         and an otherwise untouched file with one added mention in a leading
         comment stops loading. tools/check-vb.mjs group 14 enforces it. -->
    <TargetPlatformIdentifier>WindowsPhoneApp</TargetPlatformIdentifier>
    <MinimumVisualStudioVersion>12</MinimumVisualStudioVersion>
    <FileAlignment>512</FileAlignment>
    <!-- The Windows Phone 8.1 class library flavour, the first GUID VS2013 writes
         from
           ProjectTemplates\VisualBasic\Windows Phone 8.1\1033\
           WindowsPhoneClassLibrary\ClassLibrary.vbproj
         under the Visual Studio install, and the value a Windows Phone 8.1 app
         template writes for itself. Both must match for the IDE to accept the
         reference.

         {BC8A1FFA-BEE3-4634-8014-F334798102B3} is the WINDOWS STORE library
         flavour, taken from
           ProjectTemplates\VisualBasic\Windows Store\1033\
           ClassLibrary_WindowsStoreApps\ClassLibrary.vbproj
         These files carried it while declaring TargetPlatformIdentifier
         WindowsPhoneApp, which is why the IDE reported "The referenced component
         'BrowserForWP.Crypto' could not be found" for a project that was present,
         correct and already built. MSBuild compares neither GUID and the guest
         build stayed green throughout. Enforced by group 14 of
         tools/check-vb.mjs. -->
    <ProjectTypeGuids>{76F1466A-8B6D-4E39-A767-685A06062A39};{F184B08F-C81C-45F6-A57F-5ABD9991F28F}</ProjectTypeGuids>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <DefineDebug>true</DefineDebug>
    <DefineTrace>true</DefineTrace>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG,TRACE,NETFX_CORE</DefineConstants>
    <DocumentationFile>BrowserForWP.Crypto.xml</DocumentationFile>
    <NoWarn>41999,42016,42017,42018,42019,42020,42021,42022,42032,42036,42314</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <DefineDebug>false</DefineDebug>
    <DefineTrace>true</DefineTrace>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE,NETFX_CORE</DefineConstants>
    <DocumentationFile>BrowserForWP.Crypto.xml</DocumentationFile>
    <NoWarn>41999,42016,42017,42018,42019,42020,42021,42022,42032,42036,42314</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|ARM' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <DefineDebug>true</DefineDebug>
    <DefineTrace>true</DefineTrace>
    <OutputPath>bin\ARM\Debug\</OutputPath>
    <DefineConstants>DEBUG,TRACE,NETFX_CORE</DefineConstants>
    <DocumentationFile>BrowserForWP.Crypto.xml</DocumentationFile>
    <PlatformTarget>ARM</PlatformTarget>
    <UseVSHostingProcess>false</UseVSHostingProcess>
    <NoWarn>41999,42016,42017,42018,42019,42020,42021,42022,42032,42036,42314</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|ARM' ">
    <DebugType>pdbonly</DebugType>
    <DefineTrace>true</DefineTrace>
    <Optimize>true</Optimize>
    <OutputPath>bin\ARM\Release\</OutputPath>
    <DefineConstants>TRACE,NETFX_CORE</DefineConstants>
    <DocumentationFile>BrowserForWP.Crypto.xml</DocumentationFile>
    <PlatformTarget>ARM</PlatformTarget>
    <UseVSHostingProcess>false</UseVSHostingProcess>
    <NoWarn>41999,42016,42017,42018,42019,42020,42021,42022,42032,42036,42314</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|x86' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <DefineDebug>true</DefineDebug>
    <DefineTrace>true</DefineTrace>
    <OutputPath>bin\x86\Debug\</OutputPath>
    <DefineConstants>DEBUG,TRACE,NETFX_CORE</DefineConstants>
    <DocumentationFile>BrowserForWP.Crypto.xml</DocumentationFile>
    <PlatformTarget>x86</PlatformTarget>
    <UseVSHostingProcess>false</UseVSHostingProcess>
    <NoWarn>41999,42016,42017,42018,42019,42020,42021,42022,42032,42036,42314</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|x86' ">
    <DebugType>pdbonly</DebugType>
    <DefineTrace>true</DefineTrace>
    <Optimize>true</Optimize>
    <OutputPath>bin\x86\Release\</OutputPath>
    <DefineConstants>TRACE,NETFX_CORE</DefineConstants>
    <DocumentationFile>BrowserForWP.Crypto.xml</DocumentationFile>
    <PlatformTarget>x86</PlatformTarget>
    <UseVSHostingProcess>false</UseVSHostingProcess>
    <NoWarn>41999,42016,42017,42018,42019,42020,42021,42022,42032,42036,42314</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Reference to the Windows Phone SDK is implicit for this project type. -->
  </ItemGroup>
  <ItemGroup>
    <Compile Include="AesGcm.vb" />
    <Compile Include="Hkdf.vb" />
    <Compile Include="WinRtCrypto.vb" />
    <Compile Include="X25519.vb" />
  </ItemGroup>
  <ItemGroup>
    <Import Include="Microsoft.VisualBasic" />
    <Import Include="System" />
    <Import Include="System.Collections" />
    <Import Include="System.Collections.Generic" />
    <Import Include="System.Diagnostics" />
    <Import Include="System.Linq" />
    <Import Include="System.Text" />
    <Import Include="System.Threading.Tasks" />
    <Import Include="Windows.Security.Cryptography" />
    <Import Include="Windows.Security.Cryptography.Core" />
    <Import Include="Windows.Storage.Streams" />
  </ItemGroup>
  <PropertyGroup Condition=" '$(VisualStudioVersion)' == '' or '$(VisualStudioVersion)' &lt; '12.0' ">
    <VisualStudioVersion>12.0</VisualStudioVersion>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(TargetPlatformIdentifier)' == '' ">
    <TargetPlatformIdentifier>WindowsPhoneApp</TargetPlatformIdentifier>
  </PropertyGroup>
  <PropertyGroup>
    <OptionExplicit>On</OptionExplicit>
  </PropertyGroup>
  <PropertyGroup>
    <OptionCompare>Binary</OptionCompare>
  </PropertyGroup>
  <PropertyGroup>
    <OptionStrict>On</OptionStrict>
  </PropertyGroup>
  <PropertyGroup>
    <OptionInfer>On</OptionInfer>
  </PropertyGroup>
  <Import Project="$(MSBuildExtensionsPath)\Microsoft\WindowsXaml\v$(VisualStudioVersion)\Microsoft.Windows.UI.Xaml.VisualBasic.targets" Condition="Exists('$(MSBuildExtensionsPath)\Microsoft\WindowsXaml\v$(VisualStudioVersion)\Microsoft.Windows.UI.Xaml.VisualBasic.targets')" />
</Project>
